# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Sessions
SESSION_SECRET=super-secret-codepath-jwt-session-key-change-in-production
BCRYPT_ROUNDS=10

# External Execution Sandbox (Optional fallback if Judge0/Piston is configured)
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Database Configuration (Defaults to persistent local JSON store in /data/database.json)
DATABASE_PATH=./data/database.json

# Real Email Delivery Configuration (Zero-Dependency SMTP & Resend API)
# You can also configure this directly in the app at #notifications!
# For Gmail: Use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=CodePath Learning <your-email@gmail.com>

# Alternative: Resend API Key (Optional)
RESEND_API_KEY=

